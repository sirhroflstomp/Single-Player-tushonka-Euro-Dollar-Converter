<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SptCurrencyConverter</AssemblyName>
    <RootNamespace>SptCurrencyConverter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />
  <PropertyGroup>
    <TarkovDir Condition="'$(TarkovDir)' == ''">C:\SPT</TarkovDir>
    <ManagedDir>$(TarkovDir)\EscapeFromTarkov_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(ManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(TarkovDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(TarkovDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- SPT client reflection/patching helpers -->
    <Reference Include="spt-reflection">
      <HintPath>$(TarkovDir)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After building, drop the DLL straight into your plugins folder for fast iteration -->
  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="Exists('$(TarkovDir)\BepInEx\plugins')">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <MakeDir Directories="$(TarkovDir)\BepInEx\plugins\SptCurrencyConverter" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(TarkovDir)\BepInEx\plugins\SptCurrencyConverter" />
  </Target>

</Project>
